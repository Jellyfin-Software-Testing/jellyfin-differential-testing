  "startup": {
    "serverName": "Jellyfin Differential Test",
    "uiCulture": "en-US",
    "metadataCountryCode": "US",
    "preferredMetadataLanguage": "en"
  },
  "remoteAccess": {
    "enableRemoteAccess": true,
    "enableAutomaticPortMapping": false
  },
  "library": {
    "name": "Differential Seed Music",
    "collectionType": "music",
    "paths": [
      "/media/seed-music"
    ],
    "options": {
      "EnablePhotos": false,
      "EnableRealtimeMonitor": false,
      "EnableChapterImageExtraction": false
    }
  },
  "searchHintCases": [
    {
      "id": "valid-reference",
      "params": {
        "searchTerm": "Reference",
        "limit": 10
      }
    },
    {
      "id": "empty-term",
      "params": {
        "searchTerm": "",
        "limit": 10
      }
    },
    {
      "id": "missing-term",
      "params": {
        "limit": 10
      }
    },
    {
      "id": "single-character",
      "params": {
        "searchTerm": "a",
        "limit": 10
      }
    },
    {
      "id": "length-255",
      "params": {
        "searchTerm": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "limit": 10
      }
    },
    {
      "id": "length-1000",
      "params": {
        "searchTerm": "",
        "limit": 10
      }
    },
    {
      "id": "unicode",
      "params": {
        "searchTerm": "\u97f3\u697d\u30c6\u30b9\u30c8\ud83c\udfb5",
        "limit": 10
      }
    },
    {
      "id": "control-characters",
      "params": {
        "searchTerm": "line\nfeed\tand\rreturn",
        "limit": 10
      }
    },
