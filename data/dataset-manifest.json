{
  "schemaVersion": "1.0",
  "description": "Deterministic, version-controlled seed data for G1-06 initial-state parity.",
  "generator": "deterministic-pcm-wave",
  "files": [
    {
      "relativePath": "seed-music/01 - Reference Tone.wav",
      "sampleRateHz": 8000,
      "durationSeconds": 1,
      "frequencyHz": 440,
      "channels": 1,
      "sampleWidthBytes": 2
    },
    {
      "relativePath": "seed-music/02 - Comparison Tone.wav",
      "sampleRateHz": 8000,
      "durationSeconds": 1,
      "frequencyHz": 660,
      "channels": 1,
      "sampleWidthBytes": 2
    }
  ],
  "startup": {
    "serverName": "Jellyfin Differential Test",
    "uiCulture": "en-US",
    "metadataCountryCode": "US",
    "preferredMetadataLanguage": "en"
  },
  "remoteAccess": {
    "enableRemoteAccess": true,
    "enableAutomaticPortMapping": false
  },
  "library": {
    "name": "Differential Seed Music",
    "collectionType": "music",
    "paths": [
      "/media/seed-music"
    ],
    "options": {
      "EnablePhotos": false,
      "EnableRealtimeMonitor": false,
      "EnableChapterImageExtraction": false
    }
  },
  "searchHintCases": [
    {"id": "valid-reference", "params": {"searchTerm": "Reference", "limit": 10}},
    {"id": "empty-term", "params": {"searchTerm": "", "limit": 10}},
    {"id": "missing-term", "params": {"limit": 10}},
    {"id": "single-character", "params": {"searchTerm": "a", "limit": 10}},
    {"id": "length-255", "params": {"searchTerm": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "limit": 10}},
    {"id": "length-1000", "params": {"searchTerm": "", "limit": 10}},
    {"id": "unicode", "params": {"searchTerm": "音楽テスト🎵", "limit": 10}},
    {"id": "control-characters", "params": {"searchTerm": "line\nfeed\tand\rreturn", "limit": 10}},
    {"id": "injection-like", "params": {"searchTerm": "' OR 1=1 -- ", "limit": 10}},
    {"id": "html-like", "params": {"searchTerm": "<script>alert(\"xss\")</script>", "limit": 10}}
  ]
}
