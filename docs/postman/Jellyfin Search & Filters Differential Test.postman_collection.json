                "exec": [
                  "pm.test(\"v10.8 Search Hints - Status 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"v10.8 Response has SearchHints array\", function () {\n    var data = pm.response.json();\n    pm.expect(data).to.have.property(\"SearchHints\");\n    pm.expect(data.SearchHints).to.be.an(\"array\");\n});\n\npm.test(\"v10.8 TotalRecordCount is non-negative\", function () {\n    var data = pm.response.json();\n    pm.expect(data.TotalRecordCount).to.be.at.least(0);\n});"
                ]
              }
            }
