  "item": [
    {
      "name": "Verify Active Session (v10.9)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"v10.9 Get Sessions - Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var sessions = pm.response.json();",
              "pm.test(\"v10.9 Current Device Session exists in Active Sessions\", function () {",
              "    var match = sessions.some(function(s) {",
              "        return s.DeviceId === \"postman-differential-tester\";",
              "    });",
              "    pm.expect(match).to.be.true;",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Emby-Token",
            "value": "{{api_key_v109}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host_v109}}/Sessions",
          "host": [
            "{{host_v109}}"
          ],
          "path": [
            "Sessions"
          ]
        }
      },
      "response": []
    },
