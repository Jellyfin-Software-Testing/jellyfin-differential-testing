    {
      "name": "AuthenticateByName (v10.9)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"v10.9 Auth Success - Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var data = pm.response.json();",
              "pm.test(\"v10.9 Response contains AccessToken and SessionInfo\", function () {",
              "    pm.expect(data).to.have.property(\"AccessToken\");",
              "    pm.expect(data).to.have.property(\"SessionInfo\");",
              "});",
              "",
              "if (data.AccessToken) {",
              "    pm.environment.set(\"api_key_v109\", data.AccessToken);",
              "}",
              "if (data.SessionInfo && data.SessionInfo.Id) {",
              "    pm.environment.set(\"sessionId_v109\", data.SessionInfo.Id);",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Emby-Authorization",
            "value": "MediaBrowser Client=\"Postman\", Device=\"Postman\", DeviceId=\"postman-differential-tester\", Version=\"1.0.0\"",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"admin\",\n  \"Pw\": \"admin123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{host_v109}}/Users/AuthenticateByName",
          "host": [
            "{{host_v109}}"
          ],
          "path": [
            "Users",
            "AuthenticateByName"
          ]
        }
      },
      "response": []
    },
